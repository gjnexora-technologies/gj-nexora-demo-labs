# =============================================================================
# GJ NEXORA DEMO LAB — EMAILJS CONFIGURATION (.env.example)
# =============================================================================
# Configure these client-side environment variables in your local .env file
# and in your Vercel Project Settings > Environment Variables for Production.
#
# Obtain these credentials from your EmailJS dashboard (https://dashboard.emailjs.com):
# 1. Service ID: Email Services tab
# 2. Template ID: Email Templates tab
# 3. Public Key: Account > API Keys tab
# =============================================================================

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
